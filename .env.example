# Required environment variables for the DevOps Auditing Agent
# Copy this file to .env and fill in your credentials.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose one provider. Default is "gemini".
LLM_PROVIDER=gemini   # options: gemini | openai | anthropic

# ── Google Gemini (default) ───────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
# GOOGLE_API_KEY=your-google-api-key-here  # alternative variable name

# ── OpenAI / Compatible endpoint ─────────────────────────────────────────────
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1   # optional: override for compatible APIs

# ── Anthropic Claude ─────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── Model override (optional) ─────────────────────────────────────────────────
# LLM_MODEL=gemini-2.0-flash         # Gemini model name
# LLM_MODEL=gpt-4o-mini              # OpenAI model name
# LLM_MODEL=claude-3-5-haiku-20241022 # Anthropic model name
